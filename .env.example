# Chrome origin trial token for WebMCP, bound to the EXACT deployed origin.
# Wildcards do not cover *.vercel.app / *.netlify.app / *.pages.dev.
# Register at the Chrome origin trials console for document.modelContext.
VITE_ORIGIN_TRIAL_TOKEN=

# Deployed Cloudflare Worker proxy (worker/) so in-page agents work without
# pasting keys into the browser. Optional; localStorage keys also work locally.
VITE_PROXY_URL=
