    "graphology-communities-louvain": "^2.0.2",
    "idb-keyval": "^6.2.2",
    "mammoth": "^1.12.2",
    "qrcode": "^1.5.4",
    "rbush": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
